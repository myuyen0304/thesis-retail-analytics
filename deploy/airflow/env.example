# Chép thành .env.airflow.local tại root; không commit file chứa secret.
# Mặc định chạy thủ công DuckDB; bật lịch sau nghiệm thu.
RETAIL_PIPELINE_SCHEDULE_ENABLED=false
# Chỉ demo local, mặc định admin. Có thể đổi mật khẩu mà không sửa Compose.
RETAIL_AIRFLOW_ADMIN_PASSWORD=admin
# Chỉ điền khi chạy target databricks. Không dùng writer cho app/chat.
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
RETAIL_DATABRICKS_CATALOG=retail_lab
RETAIL_PIPELINE_CLIENT_ID=
RETAIL_PIPELINE_CLIENT_SECRET=
# Reader của giao diện public (cùng danh tính đang đọc app): bản public Streamlit đọc bằng SP retail-web-ro, nên điền
# DATABRICKS_CLIENT_ID / DATABRICKS_CLIENT_SECRET của .env.streamlit_cloud.local. Khác RETAIL_APP_DBX_PRINCIPAL của macro dbt
# (SP của bản Databricks Apps). AI: lấy từ .env.ai.local.
RETAIL_APP_DBX_CLIENT_ID=
RETAIL_APP_DBX_CLIENT_SECRET=
RETAIL_AI_DBX_CLIENT_ID=
RETAIL_AI_DBX_CLIENT_SECRET=
